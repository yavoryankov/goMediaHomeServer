{
  "manifest_version": 3,
  "name": "goMediaHomeServer Media Downloader",
  "version": "1.0.0",
  "description": "Download permitted YouTube and Vimeo media to a configured goMediaHomeServer folder.",
  "permissions": ["activeTab", "scripting", "cookies", "storage", "tabCapture", "offscreen"],
  "host_permissions": [
    "http://127.0.0.1:7070/*",
    "http://localhost:7070/*",
    "http://127.0.0.1:7071/*",
    "http://localhost:7071/*",
    "https://*.apeiron.school/*",
    "https://*.vimeo.com/*",
    "https://*.youtube.com/*",
    "https://youtu.be/*"
  ],
  "action": {
    "default_title": "Download media",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
